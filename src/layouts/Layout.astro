---
import '~/styles/global.css';
import { getAlternateLinks, type Locale } from '~/i18n';

export interface Props {
  title: string;
  description: string;
  locale: Locale;
  ogImage?: string;
  canonicalUrl?: string;
}

const { title, description, locale, ogImage, canonicalUrl } = Astro.props;

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://efendilergrup.com';
const pathname = Astro.url.pathname;
const canonical = canonicalUrl ?? `${siteUrl}${pathname === '/' ? '' : pathname}`;
const ogImageFull = ogImage
  ? (ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage}`)
  : `${siteUrl}/og-default.jpg`;

const alternates = getAlternateLinks(pathname);
const localeToHrefLang: Record<Locale, string> = {
  tr: 'tr-TR',
  en: 'en',
  ru: 'ru',
};
const ogLocaleMap: Record<Locale, string> = {
  tr: 'tr_TR',
  en: 'en_US',
  ru: 'ru_RU',
};
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />

    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={localeToHrefLang.tr} href={`${siteUrl}${alternates.tr}`} />
    <link rel="alternate" hreflang={localeToHrefLang.en} href={`${siteUrl}${alternates.en}`} />
    <link rel="alternate" hreflang={localeToHrefLang.ru} href={`${siteUrl}${alternates.ru}`} />
    <link rel="alternate" hreflang="x-default" href={`${siteUrl}${alternates.tr}`} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Efendiler Grup" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageFull} />
    <meta property="og:locale" content={ogLocaleMap[locale]} />
    {(Object.keys(ogLocaleMap) as Locale[])
      .filter((l) => l !== locale)
      .map((l) => <meta property="og:locale:alternate" content={ogLocaleMap[l]} />)}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageFull} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Source+Serif+4:opsz,wght@8..60,300;8..60,400;8..60,600;8..60,700&display=swap"
      rel="stylesheet"
    />

    <slot name="head" />
  </head>
  <body class="antialiased">
    <slot name="top-bar" />
    <slot name="nav" />
    <main>
      <slot />
    </main>
    <slot name="footer" />
  </body>
</html>
