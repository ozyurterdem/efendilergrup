---
/**
 * Ürün Detay — TR (/urunler/[slug])
 *
 * Zengin cinematic tasarım:
 *  - Full-bleed hero (85vh) — kategori görseli + büyük gradient overlay
 *  - Breadcrumb üstte (semi-transparent beyaz)
 *  - Alt kısımda: label + ürün adı + açıklama özeti + "Teklif al" CTA
 *  - 2-col content: sol açıklama/features, sağ STICKY teknik kart
 *  - "İlgili Ürünler" 3-col
 *  - CTA band + footer
 */
import Layout from '~/layouts/Layout.astro';
import Header from '~/components/Header.astro';
import Footer from '~/components/Footer.astro';
import { useTranslations, type Locale } from '~/i18n';
import {
  products,
  getCategoryByKey,
  getRelatedProducts,
  type Product,
  type ProductCategory,
} from '~/data/products';

export async function getStaticPaths() {
  return products.map((p) => ({
    params: { slug: p.slug },
    props: { product: p },
  }));
}

interface Props {
  product: Product;
}

const { product } = Astro.props;
const locale: Locale = 'tr';
const t = useTranslations(locale);
const base = locale === 'tr' ? '' : `/${locale}`;

const category = getCategoryByKey(product.category);
const related = getRelatedProducts(product, 3);

const imgByCategory: Record<ProductCategory, string> = {
  'cotton': 'img-cat1',
  'cotton-waste': 'img-cat2',
  'yarn-waste': 'img-cat3',
  'fiber-other': 'img-cat4',
};
const bgByCategory: Record<ProductCategory, string> = {
  'cotton': 'bg-ink-900',
  'cotton-waste': 'bg-forest-900',
  'yarn-waste': 'bg-sky-900',
  'fiber-other': 'bg-earth-700',
};

const categoryName = category?.names[locale] ?? product.category;
const heroImg = imgByCategory[product.category];
const relatedBg = bgByCategory;

const dash = t('detail.not_specified');
const specs = [
  { label: t('detail.specs.category'), value: categoryName },
  { label: t('detail.specs.slug'), value: product.slug, mono: true },
  { label: t('detail.specs.moq'), value: product.moq ?? dash },
  {
    label: t('detail.specs.incoterms'),
    value: product.incoterms?.join(' · ') ?? dash,
  },
  {
    label: t('detail.specs.certs'),
    value: product.certifications?.join(', ') ?? dash,
  },
];
---

<Layout
  title={`${product.names[locale]} — Efendiler Grup`}
  description={product.description[locale].slice(0, 160)}
  locale={locale}
>
  <Header slot="nav" locale={locale} />

  <!-- HERO: cinematic kategori görseli + dinamik katmanlar -->
  <section class="relative min-h-[88vh] flex items-end overflow-hidden">
    <div class:list={['absolute inset-0', heroImg]} aria-hidden="true"></div>
    <div class:list={['absolute inset-0 kb', heroImg]} aria-hidden="true"></div>
    <div
      class="absolute inset-0"
      style="background: linear-gradient(180deg, rgba(20,24,24,0.55) 0%, rgba(20,24,24,0.25) 35%, rgba(20,24,24,0.92) 100%);"
      aria-hidden="true"
    >
    </div>

    <!-- Floating cotton dots -->
    <div class="cotton-dot dot-1 float-slow" aria-hidden="true"></div>
    <div class="cotton-dot dot-2 float-med"  aria-hidden="true"></div>
    <div class="cotton-dot dot-3 float-fast" aria-hidden="true"></div>
    <div class="cotton-dot dot-4 float-med"  aria-hidden="true"></div>

    <!-- Breadcrumb -->
    <nav
      class="absolute top-8 left-8 md:left-12 z-20 text-xs text-bone-50/80 flex flex-wrap items-center gap-2"
      aria-label="Breadcrumb"
    >
      <a href={base === '' ? '/' : `${base}`} class="hover:text-bone-50">
        {t('detail.breadcrumb.home')}
      </a>
      <span class="opacity-40">›</span>
      <a href={`${base}/urunler`} class="hover:text-bone-50">
        {t('detail.breadcrumb.products')}
      </a>
      <span class="opacity-40">›</span>
      <a
        href={`${base}/urunler#cat-${product.category}`}
        class="hover:text-bone-50"
      >
        {categoryName}
      </a>
      <span class="opacity-40">›</span>
      <span class="text-bone-50 font-medium">{product.names[locale]}</span>
    </nav>

    <!-- İçerik -->
    <div class="relative z-10 w-full">
      <div class="max-w-[1400px] mx-auto px-8 pb-20 md:pb-28 pt-32">
        <div class="max-w-4xl">
          <div class="reveal reveal-1 label-xs text-bone-100 hero-text mb-6 flex items-center gap-3">
            <span>{t('detail.eyebrow')}</span>
            <span class="opacity-40">·</span>
            <span>{categoryName}</span>
          </div>
          <h1
            class="reveal reveal-2 display-xl hero-text text-bone-50 text-[clamp(2.4rem,6.5vw,5.5rem)] mb-8"
          >
            {product.names[locale]}
          </h1>
          <p
            class="reveal reveal-3 font-serif text-lg md:text-xl text-bone-100 hero-text max-w-2xl leading-relaxed font-light mb-10"
          >
            {product.description[locale]}
          </p>
          <div class="reveal reveal-3 flex flex-wrap items-center gap-4">
            <a
              href={`${base}/#teklif?product=${product.slug}`}
              class="inline-flex items-center gap-3 bg-bone-50 text-ink-900 font-medium px-8 py-4 hover:bg-forest-600 hover:text-bone-50 transition"
            >
              <span>{t('detail.cta')}</span>
              <span>→</span>
            </a>
            <a
              href={`${base}/urunler`}
              class="inline-flex items-center gap-3 border border-bone-50/40 text-bone-50 font-medium px-8 py-4 hover:bg-bone-50/10 hover:border-bone-50 transition"
            >
              <span>←</span>
              <span>{t('detail.back_to_catalog')}</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CONTENT: 2-col — sol özellikler, sağ sticky teknik kart -->
  <section class="py-24 md:py-32 bg-bone-50">
    <div class="max-w-[1400px] mx-auto px-8">
      <div class="grid lg:grid-cols-12 gap-16">
        <!-- Sol: features + açıklama expansion -->
        <div class="lg:col-span-7">
          {product.features && product.features.length > 0 && (
            <>
              <div class="label-xs text-forest-700 mb-4">
                {t('detail.features_heading')}
              </div>
              <h2 class="display-xl text-3xl md:text-4xl text-ink-900 mb-10">
                {product.names[locale]} özellikleri
              </h2>
              <ul class="space-y-6 mb-16">
                {product.features.map((feature) => (
                  <li class="border-l-2 border-forest-700 pl-6 py-1">
                    <p class="font-serif text-xl md:text-2xl text-ink-800 leading-snug font-light">
                      {feature}
                    </p>
                  </li>
                ))}
              </ul>
            </>
          )}

          <!-- Sertifika rozet şeridi -->
          {product.certifications && product.certifications.length > 0 && (
            <div class="pt-10 border-t border-bone-200">
              <div class="label-xs text-forest-700 mb-4">
                {t('detail.specs.certs')}
              </div>
              <div class="flex flex-wrap gap-3">
                {product.certifications.map((c) => (
                  <span class="inline-flex items-center gap-2 bg-white border border-forest-700/30 text-forest-800 px-4 py-2 text-sm font-medium">
                    <span class="w-1.5 h-1.5 rounded-full bg-forest-600" />
                    {c}
                  </span>
                ))}
              </div>
            </div>
          )}
        </div>

        <!-- Sağ: sticky teknik kart -->
        <aside class="lg:col-span-5">
          <div class="sticky top-32 bg-white border border-bone-200 p-8 md:p-10">
            <div class="label-xs text-forest-700 mb-6">
              {t('detail.tech_heading')}
            </div>
            <dl class="space-y-0">
              {specs.map((s, i) => (
                <div
                  class:list={[
                    'flex flex-wrap justify-between gap-4 py-4',
                    i < specs.length - 1 ? 'border-b border-bone-200' : '',
                  ]}
                >
                  <dt class="text-xs uppercase tracking-wider text-ink-700/70 font-medium">
                    {s.label}
                  </dt>
                  <dd
                    class:list={[
                      'text-sm text-ink-900 text-right max-w-[60%]',
                      s.mono ? 'font-mono' : 'font-medium',
                    ]}
                  >
                    {s.value}
                  </dd>
                </div>
              ))}
            </dl>
            <a
              href={`${base}/#teklif?product=${product.slug}`}
              class="mt-8 inline-flex items-center justify-center gap-3 w-full bg-ink-900 text-bone-50 font-medium px-6 py-4 hover:bg-forest-800 transition"
            >
              <span>{t('detail.cta')}</span>
              <span>→</span>
            </a>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <!-- İLGİLİ ÜRÜNLER -->
  {related.length > 0 && (
    <section class="py-24 md:py-32 bg-white border-t border-bone-200">
      <div class="max-w-[1400px] mx-auto px-8">
        <div class="flex flex-wrap justify-between items-end mb-12 gap-4">
          <div>
            <div class="label-xs text-forest-700 mb-4">
              {t('detail.related_heading')}
            </div>
            <h2 class="display-xl text-3xl md:text-4xl lg:text-5xl text-ink-900">
              {categoryName}
            </h2>
          </div>
          <a
            href={`${base}/urunler#cat-${product.category}`}
            class="text-sm font-semibold text-forest-800 link-arrow"
          >
            {t('products.cta.catalogue')}
          </a>
        </div>
        <div class="grid md:grid-cols-3 gap-6">
          {related.map((r) => (
            <a
              href={`${base}/urunler/${r.slug}`}
              class:list={[
                'pcard group relative overflow-hidden aspect-[4/3]',
                relatedBg[r.category],
              ]}
            >
              <div
                class:list={[
                  'absolute inset-0 pcard-img opacity-60 group-hover:opacity-80 transition-opacity duration-500',
                  imgByCategory[r.category],
                ]}
                aria-hidden="true"
              />
              <div
                class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/25 to-transparent"
                aria-hidden="true"
              />
              <div class="absolute top-5 left-5 label-xs bg-bone-50/15 backdrop-blur-sm border border-bone-50/20 text-bone-50 px-3 py-1.5">
                {categoryName}
              </div>
              <div class="absolute left-0 right-0 bottom-0 p-6 text-bone-50">
                <h3 class="font-serif text-2xl font-light mb-2 leading-tight">
                  {r.names[locale]}
                </h3>
                <div class="flex items-center justify-between">
                  <span class="text-xs text-bone-100/70 uppercase tracking-wider">
                    {r.moq?.replace(/^Min\s*/, '') ?? '—'}
                  </span>
                  <span class="text-sm flex items-center gap-2 opacity-80 group-hover:opacity-100 transition">
                    {t('catalog.view_product')}
                    <span class="transition-transform duration-300 group-hover:translate-x-1">→</span>
                  </span>
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <Footer slot="footer" locale={locale} />
</Layout>
