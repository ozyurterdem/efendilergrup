---
/**
 * Страница товара — RU (/ru/urunler/[slug]/)
 */
import Layout from '~/layouts/Layout.astro';
import Header from '~/components/Header.astro';
import Footer from '~/components/Footer.astro';
import { useTranslations, type Locale } from '~/i18n';
import {
  products,
  getCategoryByKey,
  getRelatedProducts,
  type Product,
  type ProductCategory,
} from '~/data/products';

export async function getStaticPaths() {
  return products.map((p) => ({
    params: { slug: p.slug },
    props: { product: p },
  }));
}

interface Props {
  product: Product;
}

const { product } = Astro.props as Props;

const locale: Locale = 'ru';
const t = useTranslations(locale);

const base = `/${locale}`;

const categoryMeta = getCategoryByKey(product.category);
const categoryName = categoryMeta?.names[locale] ?? product.category;

const imgByCategory: Record<ProductCategory, string> = {
  'cotton': 'img-cat1',
  'cotton-waste': 'img-cat2',
  'yarn-waste': 'img-cat3',
  'fiber-other': 'img-cat4',
};

const bgByCategory: Record<ProductCategory, string> = {
  'cotton': 'bg-ink-900',
  'cotton-waste': 'bg-forest-900',
  'yarn-waste': 'bg-sky-900',
  'fiber-other': 'bg-earth-700',
};

const accentByCategory: Record<ProductCategory, string> = {
  'cotton': 'text-ink-900',
  'cotton-waste': 'text-forest-800',
  'yarn-waste': 'text-sky-800',
  'fiber-other': 'text-earth-700',
};

const productName = product.names[locale];
const productDescription = product.description[locale];
const notSpec = t('detail.not_specified');

const specs = [
  { label: t('detail.specs.category'), value: categoryName },
  { label: t('detail.specs.slug'), value: product.slug, mono: true },
  { label: t('detail.specs.moq'), value: product.moq ?? notSpec },
  {
    label: t('detail.specs.incoterms'),
    value: product.incoterms?.join(' · ') ?? notSpec,
  },
  {
    label: t('detail.specs.certs'),
    value: product.certifications?.join(', ') ?? notSpec,
  },
];

const related = getRelatedProducts(product, 3);

const pageTitle = `${productName} — Efendiler Grup`;
const pageDesc = productDescription.slice(0, 160);

const heroImg = imgByCategory[product.category];
const heroBg = bgByCategory[product.category];
const accent = accentByCategory[product.category];
---

<Layout title={pageTitle} description={pageDesc} locale={locale}>
  <Header slot="nav" locale={locale} />

  <section class="bg-bone-50 pt-10 pb-2">
    <div class="max-w-[1400px] mx-auto px-8">
      <nav
        class="text-xs text-ink-700 flex flex-wrap items-center gap-2"
        aria-label="Breadcrumb"
      >
        <a href={base === '' ? '/' : `${base}/`} class="hover:text-forest-800">
          {t('detail.breadcrumb.home')}
        </a>
        <span class="opacity-40">›</span>
        <a href={`${base}/urunler/`} class="hover:text-forest-800">
          {t('detail.breadcrumb.products')}
        </a>
        <span class="opacity-40">›</span>
        <a
          href={`${base}/urunler/#cat-${product.category}`}
          class="hover:text-forest-800"
        >
          {categoryName}
        </a>
        <span class="opacity-40">›</span>
        <span class="text-ink-900">{productName}</span>
      </nav>
    </div>
  </section>

  <section class="bg-bone-50 py-12 md:py-20">
    <div class="max-w-[1400px] mx-auto px-8">
      <div class="grid md:grid-cols-12 gap-10 md:gap-16 items-start">
        <div class="md:col-span-6">
          <div
            class:list={[
              'relative overflow-hidden aspect-[4/5] md:aspect-[4/5]',
              heroBg,
            ]}
          >
            <div
              class:list={['absolute inset-0 pcard-img opacity-80', heroImg]}
              aria-hidden="true"
            />
            <div
              class="absolute inset-0 bg-gradient-to-t from-black/50 via-black/10 to-transparent"
              aria-hidden="true"
            />
            <div class="absolute top-6 left-6 text-bone-50">
              <div class="label-xs text-bone-100/80">
                {categoryName}
              </div>
            </div>
            <div class="absolute bottom-6 left-6 right-6 text-bone-50/90">
              <div class="text-xs font-mono tracking-wider">
                {product.slug}
              </div>
            </div>
          </div>
        </div>

        <div class="md:col-span-6">
          <div class={`label-xs mb-4 ${accent}`}>
            {t('detail.eyebrow')} · {categoryName}
          </div>
          <h1 class="display-xl text-4xl md:text-5xl lg:text-6xl text-ink-900 mb-8 leading-[0.98]">
            {productName}
          </h1>
          <p class="font-serif text-xl md:text-2xl text-ink-700 leading-snug font-light mb-12">
            {productDescription}
          </p>

          <a
            href={`${base}/#teklif?product=${product.slug}`}
            class="inline-block bg-ink-900 text-bone-50 font-medium text-sm px-8 py-4 hover:bg-forest-800 transition link-arrow"
          >
            {t('detail.cta')}
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-white border-t border-bone-200 py-20 md:py-28">
    <div class="max-w-[1400px] mx-auto px-8">
      <div class="grid md:grid-cols-12 gap-10 md:gap-16">
        <div class="md:col-span-6">
          <div class="label-xs text-forest-700 mb-6">
            {t('detail.tech_heading')}
          </div>
          <dl class="text-ink-900">
            {
              specs.map((s) => (
                <div class="py-4 flex flex-col md:flex-row md:items-baseline gap-2 md:gap-6 border-b border-bone-200">
                  <dt class="md:w-44 shrink-0 label-xs text-ink-700">
                    {s.label}
                  </dt>
                  <dd
                    class:list={[
                      'flex-1 text-sm md:text-base',
                      s.mono ? 'font-mono text-ink-700' : 'text-ink-900',
                    ]}
                  >
                    {s.value}
                  </dd>
                </div>
              ))
            }
          </dl>
        </div>

        <div class="md:col-span-6">
          {
            product.features && product.features.length > 0 ? (
              <>
                <div class="label-xs text-forest-700 mb-6">
                  {t('detail.features_heading')}
                </div>
                <ul class="border-l-2 border-forest-700 pl-8 space-y-4">
                  {product.features.map((f) => (
                    <li class="font-serif text-lg text-ink-900 leading-snug">
                      {f}
                    </li>
                  ))}
                </ul>
              </>
            ) : null
          }
        </div>
      </div>
    </div>
  </section>

  {
    related.length > 0 && (
      <section class="bg-bone-50 border-t border-bone-200 py-20 md:py-28">
        <div class="max-w-[1400px] mx-auto px-8">
          <div class="flex flex-wrap justify-between items-end mb-12 gap-6">
            <div>
              <div class="label-xs text-forest-700 mb-4">
                {categoryName}
              </div>
              <h2 class="display-xl text-3xl md:text-4xl lg:text-5xl text-ink-900">
                {t('detail.related_heading')}
              </h2>
            </div>
            <a
              href={`${base}/urunler/#cat-${product.category}`}
              class="text-sm font-semibold text-forest-800 link-arrow"
            >
              {t('detail.back_to_catalog')}
            </a>
          </div>

          <div class="grid md:grid-cols-3 gap-6">
            {related.map((r) => (
              <a
                href={`${base}/urunler/${r.slug}/`}
                class="pcard group block bg-bone-50 border border-bone-200 hover:border-forest-700 transition"
              >
                <div
                  class:list={[
                    'relative overflow-hidden aspect-[4/3]',
                    heroBg,
                  ]}
                >
                  <div
                    class:list={[
                      'absolute inset-0 pcard-img opacity-65 group-hover:opacity-80 transition-opacity',
                      heroImg,
                    ]}
                    aria-hidden="true"
                  />
                  <div
                    class="absolute inset-0 bg-gradient-to-t from-black/50 to-transparent"
                    aria-hidden="true"
                  />
                </div>
                <div class="p-6">
                  <h3 class="font-serif text-xl text-ink-900 mb-3 leading-snug">
                    {r.names[locale]}
                  </h3>
                  <p class="text-sm text-ink-700 leading-relaxed mb-4 line-clamp-2">
                    {r.description[locale]}
                  </p>
                  <span class="text-sm font-semibold text-forest-800 link-arrow">
                    {t('catalog.view_product')}
                  </span>
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <Footer slot="footer" locale={locale} />
</Layout>
