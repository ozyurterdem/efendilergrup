---
import { useTranslations, type Locale } from '~/i18n';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const base = locale === 'tr' ? '' : `/${locale}`;
const href = (hash: string) => `${base}/${hash}`;

const productLinks = t('footer.nav_products') as unknown as string[];
const companyLinks = t('footer.nav_company') as unknown as string[];

const companyHrefs = [
  href('#about'),
  href('#surdurulebilirlik'),
  href('#teklif'),
  '#',
];

const productHrefs = [
  `${href('urunler')}#cat-cotton`,
  `${href('urunler')}#cat-cotton-waste`,
  `${href('urunler')}#cat-yarn-waste`,
  `${href('urunler')}#cat-fiber-other`,
];

const year = new Date().getFullYear();
---

<footer id="iletisim" class="bg-bone-100 border-t border-bone-200">
  <div class="max-w-[1400px] mx-auto px-8 py-20">
    <div class="grid md:grid-cols-12 gap-8 mb-16">
      <div class="md:col-span-5">
        <img
          src="/logo-mark.png"
          alt="Efendiler Group Cotton"
          width="1400"
          height="497"
          class="h-24 w-auto mb-6 -ml-2"
        />
        <div class="label-xs text-forest-700 mb-6">
          Pamuk İth. İhr. Ltd. Şti.
        </div>
        <p class="text-sm text-ink-700 leading-relaxed max-w-sm mb-8">
          {t('footer.tagline')}
        </p>
        <address class="not-italic text-sm text-ink-700 leading-relaxed">
          Hal Mah. 6025 sk. No 108/A<br />
          Akdeniz / Mersin, Türkiye<br /><br />
          <a href="mailto:info@efendilergrup.com" class="hover:text-forest-800">
            info@efendilergrup.com
          </a><br />
          <a href="tel:+90XXXXXXXXXX" class="hover:text-forest-800">
            +90 XXX XXX XX XX
          </a>
        </address>
      </div>

      <div class="md:col-span-3 md:col-start-7">
        <div class="label-xs text-ink-700 mb-4">{t('footer.products_heading')}</div>
        <ul class="space-y-3 text-sm text-ink-800">
          {
            productLinks.map((link, i) => (
              <li>
                <a href={productHrefs[i]} class="hover:text-forest-800">
                  {link}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="md:col-span-3">
        <div class="label-xs text-ink-700 mb-4">{t('footer.company_heading')}</div>
        <ul class="space-y-3 text-sm text-ink-800">
          {
            companyLinks.map((link, i) => (
              <li>
                <a href={companyHrefs[i]} class="hover:text-forest-800">
                  {link}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div
      class="border-t border-bone-300 pt-6 flex flex-wrap justify-between gap-4 text-xs text-ink-700"
    >
      <div>© {year} Efendiler Grup Pamuk İth. İhr. Ltd. Şti.</div>
      <div class="flex gap-6">
        <a href="#" class="hover:text-forest-800">KVKK</a>
        <a href="#" class="hover:text-forest-800">Privacy</a>
        <a href="#" class="hover:text-forest-800">Cookies</a>
      </div>
    </div>
  </div>
</footer>
