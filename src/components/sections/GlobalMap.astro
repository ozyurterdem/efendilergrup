---
/**
 * GlobalMap section — "From Mersin, to fourteen nations."
 *
 * Editorial harita bloğu. aspect-[2/1] hero görseli (img-map) üstünde
 * Mersin koordinatları büyük tipografiyle. Altında 3 kolon ülke listesi.
 *
 * Ülke listesi i18n tarafında newline'lı string olarak tutuluyor
 * (region{N}_list). `white-space: pre-line` ile <br> yerine \n render ediyor.
 * Böylece çeviri dosyaları basit string kalıyor, `t()` string döndürüyor.
 */
export interface Props {
  t: (key: string) => string;
}

const { t } = Astro.props;
---

<section class="py-32 bg-white border-y border-bone-200">
  <div class="max-w-[1400px] mx-auto px-8">
    <div class="text-center mb-20 max-w-3xl mx-auto">
      <div class="label-xs text-forest-700 mb-4">{t('map.eyebrow')}</div>
      <h2 class="display-xl text-5xl md:text-6xl text-ink-900">
        {t('map.headline_1')} <span class="display-sub">{t('map.headline_2')}</span>
      </h2>
    </div>

    <div class="relative aspect-[2/1] bg-bone-100 overflow-hidden mb-16">
      <div class="absolute inset-0 img-map opacity-40"></div>
      <div class="absolute inset-0 bg-gradient-to-b from-bone-50/50 to-bone-100/80"></div>
      <div class="absolute inset-0 flex items-center justify-center">
        <div class="text-center">
          <div class="font-serif text-5xl md:text-7xl text-ink-900 font-light mb-4">
            Mersin · &#127481;&#127479;
          </div>
          <div class="label-xs text-ink-700">36.8&deg;N &middot; 34.6&deg;E &middot; Mediterranean Port</div>
        </div>
      </div>
    </div>

    <div class="grid md:grid-cols-3 gap-12 text-center md:text-left">
      <div>
        <div class="label-xs text-forest-700 mb-3">{t('map.region1_t')}</div>
        <div class="font-serif text-lg text-ink-900 leading-relaxed whitespace-pre-line">
          {t('map.region1_list')}
        </div>
      </div>
      <div>
        <div class="label-xs text-forest-700 mb-3">{t('map.region2_t')}</div>
        <div class="font-serif text-lg text-ink-900 leading-relaxed whitespace-pre-line">
          {t('map.region2_list')}
        </div>
      </div>
      <div>
        <div class="label-xs text-forest-700 mb-3">{t('map.region3_t')}</div>
        <div class="font-serif text-lg text-ink-900 leading-relaxed whitespace-pre-line">
          {t('map.region3_list')}
        </div>
      </div>
    </div>
  </div>
</section>
