---
/**
 * ProductsGrid.astro
 *
 * "Four categories, twenty-one SKUs." — editorial asimetrik ürün grid'i.
 *
 * Layout (md ve üzeri):
 *   +----------------+----------------+
 *   |                |   Cat 2 (4/3)  |
 *   |   Cat 1        +----------------+
 *   |   (row-span-2) |   Cat 3 (4/3)  |
 *   +----------------+----------------+
 *   |                                 |
 *   |                                 |
 *   |   Cat 4 — tek başına alt sıra?  |
 *   +---------------------------------+
 *
 * Not: Mockup davranışı 2-kolon grid — cat1 büyük (row-span-2), cat2/3 sağ
 * üst ve sağ orta, cat4 ise cat1'in altındaki 2. satırın sol hücresine
 * düşer. Grid auto-flow sayesinde: [cat1(row2), cat2, cat3, cat4] sıralaması
 * görsel olarak [cat1-big | cat2 / cat3 | cat4] yerleşimini verir.
 *
 * Her kart: `pcard` wrapper, absolute `pcard-img` (bg-image), gradient
 * overlay, z-10 içerik. Hover'da kart -3px kalkar, görsel 1.04× zoomlanır.
 *
 * i18n anahtarları:
 *   products.eyebrow            → "Products"
 *   products.title.line1        → "Four categories,"
 *   products.title.line2_em     → "twenty-one SKUs."
 *   products.cta.catalogue      → "View full catalogue"
 *   products.cat1.{label,title,desc,meta}
 *   products.cat2.{label,title,desc}
 *   products.cat3.{label,title,desc}
 *   products.cat4.{label,title,desc}
 */

import type { Product } from '~/data/products';
import { getCategoryCount } from '~/data/products';
import { localizedHref } from '~/i18n/utils';

export interface Props {
  /** Link prefix'i için locale. */
  locale?: 'tr' | 'en' | 'ru';
  /** i18n translator. */
  t: any;
  /** (Opsiyonel) ürün listesi — verilmezse alt sayaçlar `products.ts` üzerinden hesaplanır. */
  products?: Product[];
}

const { locale = 'tr', t } = Astro.props;

const catalogueHref = localizedHref(locale, 'urunler');
const catHref = (cat: string) => localizedHref(locale, `urunler#cat-${cat}`);

// Her kategorinin SKU sayısı — meta satırında ("5 ürün · Incoterms...") kullanılır.
const counts = {
  cotton: getCategoryCount('cotton'),
  cottonWaste: getCategoryCount('cotton-waste'),
  yarnWaste: getCategoryCount('yarn-waste'),
  fiberOther: getCategoryCount('fiber-other'),
};
---

<section
  id="urunler"
  class="bg-white py-32 border-t border-bone-200"
  aria-labelledby="products-heading"
>
  <div class="max-w-[1400px] mx-auto px-8">
    <!-- Başlık satırı -->
    <div class="flex flex-wrap justify-between items-end mb-16 gap-6">
      <div>
        <div class="label-xs text-forest-700 mb-4">
          {t('products.eyebrow')}
        </div>
        <h2
          id="products-heading"
          class="display-xl text-5xl md:text-6xl text-ink-900"
        >
          {t('products.title.line1')}{' '}
          <span class="display-sub">{t('products.title.line2_em')}</span>
        </h2>
      </div>
      <a
        href={catalogueHref}
        class="text-sm font-semibold text-forest-800 link-arrow"
      >
        {t('products.cta.catalogue')}
      </a>
    </div>

    <!-- Grid: 2 kolon, cat1 row-span-2 -->
    <div class="grid md:grid-cols-2 gap-6">
      <!-- Cat 1 — large (Pamuk / Cotton) -->
      <a
        href={catHref('cotton')}
        class="pcard group relative overflow-hidden bg-ink-900 aspect-[4/3] md:row-span-2 md:aspect-auto"
      >
        <div
          class="absolute inset-0 pcard-img img-cat1 opacity-70 group-hover:opacity-80 transition-opacity"
          aria-hidden="true"
        >
        </div>
        <div
          class="absolute inset-0 bg-gradient-to-t from-ink-900/90 via-ink-900/30 to-transparent"
          aria-hidden="true"
        >
        </div>
        <div
          class="relative z-10 h-full flex flex-col justify-end p-10 text-bone-50"
        >
          <div class="label-xs text-bone-100/70 mb-2">
            {t('products.cat1.label')}
          </div>
          <h3 class="display-xl text-5xl md:text-6xl mb-4">
            {t('products.cat1.title')}
          </h3>
          <p
            class="font-serif text-lg text-bone-100/90 max-w-md mb-6 font-light"
          >
            {t('products.cat1.desc')}
          </p>
          <div class="text-xs text-bone-100/60">
            {counts.cotton} {t('products.cat1.meta')}
          </div>
        </div>
      </a>

      <!-- Cat 2 — Pamuk Telefleri / Cotton Waste -->
      <a
        href={catHref('cotton-waste')}
        class="pcard group relative overflow-hidden bg-forest-900 aspect-[4/3]"
      >
        <div
          class="absolute inset-0 pcard-img img-cat2 opacity-55 group-hover:opacity-70 transition"
          aria-hidden="true"
        >
        </div>
        <div
          class="absolute inset-0 bg-gradient-to-t from-forest-900/90 to-transparent"
          aria-hidden="true"
        >
        </div>
        <div
          class="relative z-10 h-full flex flex-col justify-end p-8 text-bone-50"
        >
          <div class="label-xs text-bone-100/70 mb-2">
            {t('products.cat2.label')}
          </div>
          <h3 class="font-serif text-3xl md:text-4xl font-light mb-2">
            {t('products.cat2.title')}
          </h3>
          <p class="text-sm text-bone-100/80 max-w-sm">
            {t('products.cat2.desc')}
          </p>
        </div>
      </a>

      <!-- Cat 3 — İplik Telefleri / Yarn Waste -->
      <a
        href={catHref('yarn-waste')}
        class="pcard group relative overflow-hidden bg-sky-900 aspect-[4/3]"
      >
        <div
          class="absolute inset-0 pcard-img img-cat3 opacity-55 group-hover:opacity-70 transition"
          aria-hidden="true"
        >
        </div>
        <div
          class="absolute inset-0 bg-gradient-to-t from-sky-900/90 to-transparent"
          aria-hidden="true"
        >
        </div>
        <div
          class="relative z-10 h-full flex flex-col justify-end p-8 text-bone-50"
        >
          <div class="label-xs text-bone-100/70 mb-2">
            {t('products.cat3.label')}
          </div>
          <h3 class="font-serif text-3xl md:text-4xl font-light mb-2">
            {t('products.cat3.title')}
          </h3>
          <p class="text-sm text-bone-100/80 max-w-sm">
            {t('products.cat3.desc')}
          </p>
        </div>
      </a>

      <!-- Cat 4 — Elyaf & Diğer / Fibers & Recycling -->
      <a
        href={catHref('fiber-other')}
        class="pcard group relative overflow-hidden bg-earth-700 aspect-[4/3]"
      >
        <div
          class="absolute inset-0 pcard-img img-cat4 opacity-55 group-hover:opacity-70 transition"
          aria-hidden="true"
        >
        </div>
        <div
          class="absolute inset-0 bg-gradient-to-t from-earth-700/90 to-transparent"
          aria-hidden="true"
        >
        </div>
        <div
          class="relative z-10 h-full flex flex-col justify-end p-8 text-bone-50"
        >
          <div class="label-xs text-bone-100/70 mb-2">
            {t('products.cat4.label')}
          </div>
          <h3 class="font-serif text-3xl md:text-4xl font-light mb-2">
            {t('products.cat4.title')}
          </h3>
          <p class="text-sm text-bone-100/80 max-w-sm">
            {t('products.cat4.desc')}
          </p>
        </div>
      </a>
    </div>
  </div>
</section>
