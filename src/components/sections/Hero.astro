---
/**
 * Hero.astro — editorial full-bleed hero
 *
 * Full-bleed pamuk tarlası, güçlü ken-burns parallax, fade-in staged
 * animasyon, floating cotton dots, bouncing scroll hint.
 * "At a glance" kartı kaldırıldı — odak tek bir güçlü başlıkta.
 *
 * CSS sınıfları `src/styles/global.css` içinde:
 *   img-hero, kb, display-xl, display-sub, label-xs, link-arrow,
 *   reveal, reveal-1, reveal-2, reveal-3, float-slow, float-med,
 *   float-fast, scroll-bounce
 */

import { localizedHref } from '~/i18n/utils';

export interface Props {
  locale: 'tr' | 'en' | 'ru';
  t: any;
}

const { locale, t } = Astro.props;

const productsHref = localizedHref(locale, '#urunler');
const quoteHref = localizedHref(locale, '#teklif');
---

<section
  class="hero-section relative min-h-[100vh] flex items-end overflow-hidden"
  aria-labelledby="hero-heading"
>
  <!-- Arka plan — sabit -->
  <div class="absolute inset-0 img-hero" aria-hidden="true"></div>

  <!-- Arka plan — ken-burns yavaş zoom (üstte, opacity ile kendinden geçiyor) -->
  <div class="absolute inset-0 img-hero kb" aria-hidden="true"></div>

  <!-- Karartma gradient -->
  <div class="absolute inset-0 hero-scrim" aria-hidden="true"></div>

  <!-- Floating cotton dots (hareket için) -->
  <div class="cotton-dot dot-1 float-slow" aria-hidden="true"></div>
  <div class="cotton-dot dot-2 float-med"  aria-hidden="true"></div>
  <div class="cotton-dot dot-3 float-fast" aria-hidden="true"></div>
  <div class="cotton-dot dot-4 float-med"  aria-hidden="true"></div>

  <!-- İçerik -->
  <div class="relative z-10 w-full">
    <div class="max-w-[1400px] mx-auto px-8 pb-24 md:pb-32 pt-40">
      <div class="max-w-5xl">
        <div class="reveal reveal-1 label-xs text-bone-100 hero-text mb-6">
          {t('hero.eyebrow')}
        </div>

        <h1
          id="hero-heading"
          class="reveal reveal-2 display-xl hero-text text-bone-50 text-[clamp(2.8rem,8.5vw,8.5rem)] mb-10"
        >
          {t('hero.title.line1')}<br />
          <span class="display-sub">{t('hero.title.line2_em')}</span><br />
          {t('hero.title.line3')}
        </h1>

        <p class="reveal reveal-3 font-serif text-xl md:text-2xl text-bone-100 hero-text max-w-2xl leading-snug font-light mb-10">
          {t('hero.subtitle')}
        </p>

        <div class="reveal reveal-3 flex flex-wrap items-center gap-4">
          <a
            href={productsHref}
            class="group inline-flex items-center gap-3 bg-bone-50 text-ink-900 font-medium px-7 py-4 hover:bg-forest-600 hover:text-bone-50 transition-all duration-300"
          >
            <span>{t('hero.cta.explore')}</span>
            <span class="inline-block transition-transform duration-300 group-hover:translate-x-1">→</span>
          </a>
          <a
            href={quoteHref}
            class="inline-flex items-center gap-3 border border-bone-50/40 text-bone-50 font-medium px-7 py-4 hover:bg-bone-50/10 hover:border-bone-50 transition-all duration-300"
          >
            <span>{t('nav.quote')}</span>
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Scroll hint — zıplar -->
  <div
    class="absolute bottom-10 left-1/2 -translate-x-1/2 text-bone-50/70 z-10 scroll-bounce"
    aria-hidden="true"
  >
    <div class="flex flex-col items-center gap-2">
      <span class="label-xs">{t('hero.scroll')}</span>
      <span class="inline-block w-[1px] h-8 bg-bone-50/50"></span>
    </div>
  </div>
</section>
