---
/**
 * Sustainability section — "Transparent. Traceable. Responsible."
 *
 * 2 kolonlu layout: sol görsel (img-sustain) + sağ metin & 3 kart.
 * Kartlar border-l-2 forest-700 çizgili editorial stilinde.
 * Mobile'da görsel alttan (order-1 text üstte, order-2 visual altta).
 */
export interface Props {
  t: (key: string) => string;
}

const { t } = Astro.props;
---

<section id="surdurulebilirlik" class="py-32 bg-bone-50">
  <div class="max-w-[1400px] mx-auto px-8">
    <div class="grid lg:grid-cols-2 gap-16 items-center">
      <div class="relative aspect-[4/5] bg-bone-200 overflow-hidden order-2 lg:order-1">
        <div class="absolute inset-0 img-sustain"></div>
      </div>
      <div class="order-1 lg:order-2">
        <div class="label-xs text-forest-700 mb-6">{t('sustain.eyebrow')}</div>
        <h2 class="display-xl text-5xl md:text-6xl text-ink-900 mb-10">
          {t('sustain.line_1')}<br />
          {t('sustain.line_2')}<br />
          <span class="display-sub">{t('sustain.line_3')}</span>
        </h2>
        <div class="space-y-8">
          <div class="border-l-2 border-forest-700 pl-6">
            <div class="font-serif text-xl text-ink-900 mb-1">{t('sustain.card1_t')}</div>
            <div class="text-sm text-ink-700">{t('sustain.card1_d')}</div>
          </div>
          <div class="border-l-2 border-forest-700 pl-6">
            <div class="font-serif text-xl text-ink-900 mb-1">{t('sustain.card2_t')}</div>
            <div class="text-sm text-ink-700">{t('sustain.card2_d')}</div>
          </div>
          <div class="border-l-2 border-forest-700 pl-6">
            <div class="font-serif text-xl text-ink-900 mb-1">{t('sustain.card3_t')}</div>
            <div class="text-sm text-ink-700">{t('sustain.card3_d')}</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
